# ── TTS Provider ─────────────────────────────────────────────
# "vieneu" = VieNeu TTS (chạy local / CIT Voice Studio) | "edge" = Edge TTS (miễn phí, pure Node.js) | "vbee" = Vbee TTS (cần tài khoản)
TTS_PROVIDER=edge

# ── VieNeu TTS (chỉ cần khi TTS_PROVIDER=vieneu) ────────────
# API endpoint của CIT Voice Studio / VieNeu-TTS
VIENEU_API_URL=http://127.0.0.1:8001
# API Key (chỉ cần nếu gọi tới CIT Voice Studio trên máy khác qua LAN)
VIENEU_API_KEY=
# Giọng đọc mặc định: Hải Đăng, Adam bựa, Trúc Ly, Thiện Minh, Mai Anh, Thùy Dung, Thiền Tâm Đức... (xem vieneu.md hoặc GET /voices)
VIENEU_VOICE=Hải Đăng
# Tốc độ đọc (1.0 = mặc định, từ 0.5 đến 2.0)
VIENEU_SPEED=1.0

# ── Edge TTS (chỉ cần khi TTS_PROVIDER=edge) ────────────────
# vi-VN-NamMinhNeural (nam) | vi-VN-HoaiMyNeural (nữ)
EDGE_VOICE=vi-VN-NamMinhNeural

# ── Vbee TTS (chỉ cần khi TTS_PROVIDER=vbee) ────────────────
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
# Giọng đọc Vbee — danh sách khác xem vbee.md hoặc trên trang chủ vbee § 5
VBEE_VOICE_CODE=

# ── AI Script Assistant ─────────────────────────────────────
# API Key của OpenAI (sk-...) hoặc Google Gemini (AIza...) để tự động viết kịch bản
AI_API_KEY=

# ── Video series ─────────────────────────────────────────────
# Tên kênh hiển thị trên eyebrow tag (#eyebrow) trong mọi video
CHANNEL=Phía sau sân cỏ

# 0 = skill dừng lại xác nhận từng bước | 1 = chạy tự động không hỏi
AUTO_CREATE_VIDEO=0